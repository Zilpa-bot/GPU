# Hebrew Voice AI Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# Telnyx Configuration
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PHONE_NUMBER=+972555078904
TELNYX_CONNECTION_ID=your_connection_id_here
TELNYX_APPLICATION_ID=your_application_id_here

# Public Domain Configuration (for webhooks)
PUBLIC_DOMAIN=your-subdomain.loca.lt

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Google AI Configuration (for Step 5)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=8000
AUDIO_FRAME_DURATION_MS=20
VAD_AGGRESSIVENESS=2
SILENCE_THRESHOLD_MS=800
MAX_UTTERANCE_LENGTH_MS=10000

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false

# Hebrew Language Configuration
SPEECH_LANGUAGE=he-IL
TTS_LANGUAGE=he-IL
AI_LANGUAGE=hebrew 